{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "types": ["vite/client"],
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "experimentalDecorators": true,
        "useDefineForClassFields": false,
        "isolatedModules": true,
        "allowJs": true,
        "skipLibCheck": true,
        "noEmit": true
    },
    "include": ["src"]
}
