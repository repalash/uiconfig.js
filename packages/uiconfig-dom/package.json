{
  "name": "uiconfig-dom",
  "version": "0.1.0",
  "description": "A small plain-DOM renderer for uiconfig.js configs: a form, a toolbar or a stack of buttons, with no UI library. To be used with uiconfig.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "source": "src/index.ts",
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "compile:esm": "tsc -p ./src && dts-js-extensions lib/esm",
    "build": "vite build && npm run compile:esm",
    "dev": "NODE_ENV=development vite build --watch",
    "test": "npm run check && vitest run",
    "prepack": "npm run build && npm run docs",
    "docs": "typedoc ./src/index.ts",
    "lint": "eslint src --fix",
    "check": "tsc -p tsconfig.json --noEmit && eslint src",
    "new:pack": "npm run prepack && clean-package && npm pack; clean-package restore"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./dist/": {
      "import": "./dist/"
    },
    "./lib/esm": {
      "types": "./lib/esm/index.d.ts",
      "import": "./lib/esm/index.js"
    },
    "./lib/esm/*": {
      "types": "./lib/esm/*.d.ts",
      "import": "./lib/esm/*.js"
    }
  },
  "clean-package": {
    "remove": [
      "clean-package",
      "scripts",
      "devDependencies",
      "optionalDependencies"
    ]
  },
  "files": [
    "lib",
    "dist",
    "src",
    "docs",
    "tsconfig.json",
    "NOTICE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/repalash/uiconfig.js.git",
    "directory": "packages/uiconfig-dom"
  },
  "keywords": [
    "ui",
    "gui",
    "form",
    "toolbar",
    "controls",
    "config",
    "uiconfig",
    "dom",
    "vanilla",
    "three.js",
    "typescript",
    "javascript"
  ],
  "author": "repalash <palash@shaders.app>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/repalash/uiconfig.js/issues"
  },
  "homepage": "https://repalash.com/uiconfig.js/",
  "dependencies": {
    "uiconfig.js": "^0.5.0",
    "ts-browser-helpers": ">=0.19.4"
  },
  "devDependencies": {
    "@rollup/plugin-replace": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "clean-package": "^2.2.0",
    "eslint": "^8.57.1",
    "eslint-plugin-deprecation": "^3.0.0",
    "eslint-plugin-html": "^8.1.2",
    "eslint-plugin-import": "^2.31.0",
    "rollup-plugin-license": "^3.0.1",
    "three": "^0.186.1",
    "typedoc": "^0.27.5",
    "typescript": "^5.7.2",
    "vite": "^7.2.6",
    "vite-plugin-dts": "^4.4.0",
    "vitest": "^4.1.2"
  },
  "browserslist": [
    "defaults"
  ]
}
