{
    "name": "uiconfig.js",
    "version": "0.4.1",
    "description": "A framework for building user interface layouts with JSON configuration.",
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "source": "src/index.ts",
    "browser": "dist/index.js",
    "sideEffects": false,
    "type": "module",
    "scripts": {
        "build": "rimraf dist ; tsc && vite build && vite build --mode umd",
        "dev": "NODE_ENV=development vite build --watch",
        "serve-docs": "ws -d docs -p 8080",
        "test": "npm run check",

        "serve": "ws",
        "prepack": "npm run build && npm run docs",
        "docs": "typedoc ./src/index.ts",
        "lint": "eslint src --fix",
        "check": "tsc -p tsconfig.json --noEmit && eslint src",
        "prepublishOnly": "npm run test",

        "new:pack": "npm run prepack && clean-package && npm pack; clean-package restore"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        },
        "./dist/": {
            "import": "./dist/",
            "require": "./dist/"
        },
        "./src/": {
            "import": "./src/",
            "require": "./src/"
        }
    },
    "clean-package": {
        "remove": [
            "clean-package",
            "scripts",
            "devDependencies",
            "optionalDependencies"
        ]
    },
    "files": [
        "dist",
        "src",
        "docs",
        "tsconfig.json"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/repalash/uiconfig.js.git",
        "directory": "packages/uiconfig.js"
    },
    "keywords": [
        "ui",
        "gui",
        "config",
        "configuration",
        "panel",
        "controls",
        "inspector",
        "decorators",
        "typescript",
        "javascript",
        "json",
        "three.js",
        "tweakpane",
        "blueprint",
        "dat.gui",
        "lil-gui"
    ],
    "author": "repalash <palash@shaders.app>",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/repalash/uiconfig.js/issues"
    },
    "homepage": "https://repalash.com/uiconfig.js/",
    "devDependencies": {
        "@rollup/plugin-json": "^6.1.0",
        "clean-package": "^2.2.0",
        "rollup-plugin-license": "^3.0.1",
        "typedoc": "^0.28.9",
        "typescript": "^5.7.2",
        "vite": "^7.2.6",
        "tslib": "^2.8.1",
        "local-web-server": "^5.4.0",
        "vite-plugin-dts": "^4.4.0",
        "rimraf": "^6.0.1",
        "@rollup/plugin-replace": "^6.0.2",
        "typedoc-plugin-markdown": "^4.8.0",
        "@typescript-eslint/eslint-plugin": "^5.53.0",
        "@typescript-eslint/parser": "^5.53.0",
        "eslint": "^8.57.1",
        "eslint-plugin-deprecation": "^3.0.0",
        "eslint-plugin-html": "^8.1.2",
        "eslint-plugin-import": "^2.31.0"
    },
    "dependencies": {
        "ts-browser-helpers": ">=0.19.4"
    },
    "optionalDependencies": {
        "win-node-env": "^0.6.1"
    },
    "browserslist": [
        "defaults"
    ]
}
