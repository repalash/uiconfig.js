{
  "name": "uiconfig-blueprint",
  "name:umd": "bpui",
  "version": "0.1.0-dev.16",
  "publishConfig": {
    "tag": "latest"
  },
  "description": "Blueprint.js wrapper and custom components for web controls UI. To be used with uiconfig.",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "browser": "dist/index.js",
  "types": "dist/index.d.ts",
  "source": "src/index.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "browser": "./dist/index.js"
    },
    "./dist/": {
      "import": "./dist/",
      "require": "./dist/"
    },
    "./lib": {
      "types": "./lib/esm/lib.d.ts",
      "import": "./lib/esm/lib.js"
    },
    "./lib/esm": {
      "types": "./lib/esm/index.d.ts",
      "import": "./lib/esm/index.js"
    },
    "./lib/esm/*": {
      "types": "./lib/esm/*.d.ts",
      "import": "./lib/esm/*.js"
    },
    "./lib/css/*": {
      "import": "./lib/css/*.css",
      "require": "./lib/css/*.css"
    },
    "./src/": {
      "import": "./src/",
      "require": "./src/"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "compile": "run-p \"compile:*\" && npm run postcompile:esm",
    "compile:esm:watch": "tsc -p ./src  --watch",
    "compile:esm": "tsc -p ./src",
    "compile:css": "sass-compile ./src",
    "postcompile:esm": "node scripts/fix-css-imports.mjs && node ../../scripts/fix-dts-imports.mjs lib/esm",
    "dev:lib": "run-p \"compile:esm --watch\" \"compile:css --watch\"",
    "dist:css": "css-dist lib/css",
    "new:pack": "npm run prepack && clean-package && npm pack; clean-package restore",
    "build": "vite build && vite build --mode umd && npm run compile",
    "docs": "typedoc ./src/index.ts",
    "serve-docs": "ws -d docs -p 8080",
    "prepack": "npm run build && npm run docs",
    "lint": "eslint src --fix"
  },
  "clean-package": {
    "remove": [
      "clean-package",
      "scripts",
      "devDependencies",
      "optionalDependencies"
    ],
    "replace": {
      "main": "dist/index.cjs",
      "module": "dist/index.mjs",
      "browser": "dist/index.js",
      "types": "dist/index.d.ts"
    }
  },
  "files": [
    "lib",
    "dist",
    "src",
    "docs",
    "tsconfig.json",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/repalash/uiconfig.js.git",
    "directory": "packages/uiconfig-blueprint"
  },
  "keywords": [
    "ui",
    "gui",
    "panel",
    "inspector",
    "editor",
    "controls",
    "blueprint",
    "blueprintjs",
    "react",
    "config",
    "uiconfig",
    "three.js",
    "typescript"
  ],
  "author": "repalash <palash@shaders.app>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/repalash/uiconfig.js/issues"
  },
  "homepage": "https://repalash.com/uiconfig.js/",
  "devDependencies": {
    "@rollup/plugin-json": "^6.0.0",
    "clean-package": "^2.2.0",
    "@rollup/plugin-replace": "^5.0.2",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.13",
    "local-web-server": "^5.3.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.32",
    "rimraf": "^5.0.1",
    "rollup-plugin-license": "^3.0.1",
    "sass": "^1.69.5",
    "tslib": "^2.5.0",
    "typedoc": "^0.25.4",
    "typescript": "^5.3.3",
    "vite": "^7.2.6",
    "vite-plugin-dts": "^4.4.0",
    "@blueprintjs/node-build-scripts": "^10.0.1",
    "normalize.css": "^8.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-colorful": "^5.6.1",
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "@blueprintjs/core": "^5.19.1",
    "@types/three": "^0.152.1",
    "@types/webxr": "^0.5.10",
    "blueprint-styler": "^5.0.2"
  },
  "dependencies": {
    "ts-browser-helpers": ">=0.19.4",
    "uiconfig.js": "^0.4.1",
    "@blueprintjs/icons": "^5.23.0",
    "@blueprintjs/select": "^5.3.21",
    "blueprint-styler": "^5.0.2",
    "react-colorful": "^5.6.1",
    "classnames": "^2.5.1"
  },
  "peerDependencies": {
    "@blueprintjs/core": "^5.19.1",
    "@types/three": "^0.152.1",
    "@types/webxr": "^0.5.10",
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@types/three": {
      "optional": true
    },
    "@types/webxr": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    },
    "@types/react-dom": {
      "optional": true
    }
  },
  "//": {
    "scripts": {
      "compile:cjs": "tsc -p ./src -m commonjs --verbatimModuleSyntax false --outDir lib/cjs",
      "compile:esnext": "tsc -p ./src -t esnext --outDir lib/esnext"
    }
  },
  "optionalDependencies": {
    "win-node-env": "^0.6.1"
  },
  "browserslist": [
    "defaults"
  ],
  "type": "module"
}
